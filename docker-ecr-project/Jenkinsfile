pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  parameters {
    string(
      name: 'AWS_REGION',
      defaultValue: 'ap-south-1',
      description: 'AWS Region where the ECR repository exists or will be created.'
    )
    string(
      name: 'ECR_REPOSITORY',
      defaultValue: 'jenkins-b2-docker-app',
      description: 'Private Amazon ECR repository name.'
    )
    string(
      name: 'IMAGE_TAG',
      defaultValue: '',
      description: 'Optional image tag. Leave blank to use build-${BUILD_NUMBER}.'
    )
  }

  environment {
    AWS_CREDENTIALS_ID = 'aws-ecr-credentials'
    DOCKER_BUILDKIT = '1'
  }

  stages {
    stage('Validate Parameters') {
      steps {
        script {
          env.RESOLVED_IMAGE_TAG = params.IMAGE_TAG?.trim()
            ? params.IMAGE_TAG.trim()
            : "build-${env.BUILD_NUMBER}"

          if (!(params.AWS_REGION ==~ /^[a-z]{2}(-gov)?-[a-z0-9-]+-[0-9]$/)) {
            error("Invalid AWS_REGION: ${params.AWS_REGION}")
          }

          if (!(params.ECR_REPOSITORY ==~ /^[a-z0-9]+((\.|_|__|-+)[a-z0-9]+)*(\/[a-z0-9]+((\.|_|__|-+)[a-z0-9]+)*)*$/)) {
            error("Invalid ECR_REPOSITORY: ${params.ECR_REPOSITORY}")
          }

          if (!(env.RESOLVED_IMAGE_TAG ==~ /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$/)) {
            error("Invalid image tag: ${env.RESOLVED_IMAGE_TAG}")
          }
        }
      }
    }

    stage('Check Tools') {
      steps {
        sh '''
          set -e
          docker --version
          aws --version
        '''
      }
    }

    stage('Build Image') {
      steps {
        sh '''
          set -e
          docker build \
            --pull \
            --label project=jenkins-b2-ecr \
            --tag "${ECR_REPOSITORY}:${RESOLVED_IMAGE_TAG}" \
            docker-ecr-project
        '''
      }
    }

    stage('Ensure ECR Repository') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: env.AWS_CREDENTIALS_ID,
            usernameVariable: 'AWS_ACCESS_KEY_ID',
            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
          )
        ]) {
          script {
            env.AWS_ACCOUNT_ID = sh(
              script: 'aws sts get-caller-identity --query Account --output text',
              returnStdout: true
            ).trim()
            env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
            env.ECR_IMAGE_URI = "${env.ECR_REGISTRY}/${params.ECR_REPOSITORY}:${env.RESOLVED_IMAGE_TAG}"
            env.ECR_LATEST_URI = "${env.ECR_REGISTRY}/${params.ECR_REPOSITORY}:latest"
          }

          sh '''
            set -e
            aws ecr describe-repositories \
              --repository-names "${ECR_REPOSITORY}" \
              --region "${AWS_REGION}" >/dev/null 2>&1 \
            || aws ecr create-repository \
              --repository-name "${ECR_REPOSITORY}" \
              --image-scanning-configuration scanOnPush=true \
              --region "${AWS_REGION}"
          '''
        }
      }
    }

    stage('Login And Push') {
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: env.AWS_CREDENTIALS_ID,
            usernameVariable: 'AWS_ACCESS_KEY_ID',
            passwordVariable: 'AWS_SECRET_ACCESS_KEY'
          )
        ]) {
          sh '''
            set -e
            aws ecr get-login-password --region "${AWS_REGION}" \
              | docker login --username AWS --password-stdin "${ECR_REGISTRY}"

            docker tag "${ECR_REPOSITORY}:${RESOLVED_IMAGE_TAG}" "${ECR_IMAGE_URI}"
            docker push "${ECR_IMAGE_URI}"

            docker tag "${ECR_REPOSITORY}:${RESOLVED_IMAGE_TAG}" "${ECR_LATEST_URI}"
            docker push "${ECR_LATEST_URI}"
          '''
        }
      }
    }
  }

  post {
    success {
      echo "Pushed Docker image: ${env.ECR_IMAGE_URI}"
      echo "Updated latest tag: ${env.ECR_LATEST_URI}"
    }
    always {
      sh '''
        if [ -n "${ECR_REGISTRY:-}" ]; then
          docker logout "${ECR_REGISTRY}" || true
        fi
      '''
      echo "Pipeline finished with status: ${currentBuild.currentResult}"
    }
  }
}
